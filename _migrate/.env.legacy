# ─── Google Gemini AI ───────────────────────────────────────────
# API key artık Vercel Environment Variables üzerinde gizli olarak (GEMINI_API_KEY) saklanıyor.
# Frontend'e asla gönderilmez.
GEMINI_API_KEY=AIzaSyDZZJqQIA6ahpQu7Nmn15Jm7Qqs4FKA_1c
# Local backend base URL for emulator — sadece emülatör çalışıyorken kullanılır.
VITE_BACKEND_BASE_URL=https://us-central1-learnup-3cdb7.cloudfunctions.net
# VITE_BACKEND_BASE_URL=https://us-central1-learnup-3cdb7.cloudfunctions.net

# Firestore ve Auth emülatörlerini aktif etmek için true yapın
# FALSE = Production Firestore kullan (gerçek öğrenci verileri burada)
VITE_USE_EMULATOR=false
# ─── Firebase ───────────────────────────────────────────────────
# (İsteğe bağlı) Firebase bilgileri zaten firebase.js içinde varsa buraya taşıyabilirsin
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=

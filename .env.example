# Bu dosya .env'in şablonudur. Gerçek değerleri .env'e yaz, repo'ya commit etme.
# Yeni katılan geliştirici: `cp .env.example .env` sonra değerleri doldur.

# Firebase Web Config — Firebase Console → Project settings → Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Cloud Functions
EXPO_PUBLIC_BACKEND_BASE_URL=
EXPO_PUBLIC_FUNCTIONS_REGION=us-central1

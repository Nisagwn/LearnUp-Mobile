rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // MVP güvenlik duruşu:
    //  • Okuma: giriş yapmış her kullanıcıya açık (öğretmen↔öğrenci karşılıklı
    //    okumalar — sınıf listesi, sıralama, duyuru, ödev — buna bağlı).
    //  • Yazma: koleksiyon bazında sahiplik kuralıyla kısıtlı.
    //    Önceki "herkes her şeyi yazabilir" catch-all'ı kaldırıldı.

    // Kullanıcı profilleri — sınıfa katılma ve öğrenci onaylama akışları
    // öğretmen↔öğrenci karşılıklı yazma gerektirdiği için yazma açık tutulur.
    // Ancak oyunlaştırma alanları (gamification, unlockedBadges) yalnızca
    // Cloud Functions / Admin SDK tarafından yazılabilir — istemci değiştiremez.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['gamification', 'unlockedBadges']);
      allow delete: if request.auth != null;

      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Spaced Repetition kartları — yalnızca sahibi okur, yazma sadece Cloud Functions.
      match /srs_cards/{cardId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Bookmark klasörleri — yalnızca sahibi yönetir.
      match /bookmark_folders/{folderId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // In-app bildirim merkezi — kullanıcı yalnız okur ve `readAt` alanını
      // güncelleyebilir; içerik (title/body/type/...) sadece Cloud Functions
      // tarafından yazılır. Silme yalnızca sahibine açık (UI'da long-press sil).
      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if false;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['readAt']);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Haftalık lig sıralama kayıtları — herkes okur; yalnızca Cloud Functions yazar.
    match /league_entries/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Soru havuzu — herkes okur; öğretmen yazma kapsamı:
    //  • create: yalnız sahip öğretmen (teacherId == auth.uid). AI üretimli soruları
    //    havuza yazan akış Admin SDK üzerinden (saveAIQuestions Cloud Function)
    //    geldiği için bu kural devre dışı kalır — client tarafından AI yazımı yok.
    //  • update/delete: ya doküman sahibi öğretmen, ya da role == 'teacher' olan
    //    herhangi bir öğretmen (havuz onay/sil aksiyonu için). AI dokümanlarının
    //    teacherId'si null'dur; bunları sahip olmayan öğretmen onaylayabilsin diye
    //    role check'i gerekiyor.
    match /questions/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (
          resource.data.teacherId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
        );
    }

    // Ödevler — öğrenci atanan ödevi okur; yalnızca sahibi öğretmen yönetir.
    match /assignments/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }

    // Ödev gönderimleri — öğrenci kendi gönderimini yazar; ödevi yaratan
    // öğretmen feedback/score/status alanlarını güncelleyebilir.
    match /assignment_submissions/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow update: if request.auth != null
        && (
          resource.data.studentId == request.auth.uid
          || resource.data.teacherId == request.auth.uid
        );
    }

    // Hedefli atama (öğretmenin belirli öğrenciye verdiği soru seti).
    // Öğretmen create/update/delete sahibi; öğrenci sadece kendisine
    // verilmiş atamayı okur ve cevaplamayı bitirdiğinde tamamlama
    // alanlarını günceller. Yazma yine Cloud Function tarafında
    // (submitTargetedAssignment) gerçekleşir, ama doğrudan yazıma da izin
    // veriyoruz — sahiplik şartı koruyor.
    match /targeted_assignments/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if request.auth != null
        && (
          resource.data.teacherId == request.auth.uid
          || resource.data.studentId == request.auth.uid
        );
    }

    // Duyurular — herkes okur; yalnızca sahibi öğretmen yayınlar/siler.
    match /announcements/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.teacherId == request.auth.uid;
    }

    // Favori sorular — öğrenci yalnızca kendi favorisini yazar/siler.
    // Update edilebilen alanlar kısıtlı: kullanıcı klasör/etiket/not gibi
    // organizasyon alanlarını değiştirebilir; soru içeriğini (questionText,
    // choices, answer, subject, studentId) DEĞİŞTİREMEZ.
    match /bookmarks/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.studentId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['folderId', 'tags', 'note', 'reviewCount', 'lastReviewedAt']);
    }

    // Kişisel notlar — öğrenci yalnızca kendi notunu yazar/düzenler/siler.
    match /notes/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.studentId == request.auth.uid;
    }

    // Cevap logları — artık yalnızca recordAnswer Cloud Function yazar.
    match /user_logs/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Analitik & oturum koleksiyonları (submitAnswer tarafından yazılır)
    match /user_answers/{id} { allow read, write: if request.auth != null; }
    match /quiz_sessions/{id} { allow read, write: if request.auth != null; }

    // Diğer tüm dökümanlar: okuma açık, doğrudan yazma reddedilir.
    match /{document=**} {
      allow read: if request.auth != null;
    }
  }
}
